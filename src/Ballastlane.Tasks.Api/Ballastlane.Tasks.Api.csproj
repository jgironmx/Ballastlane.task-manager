<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3df5b284-9129-45a4-9220-a582950fe93b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Required by the "dotnet ef" CLI when Api is used as the EF Core startup project; not used at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ballastlane.Tasks.Application\Ballastlane.Tasks.Application.csproj" />
    <ProjectReference Include="..\Ballastlane.Tasks.Infrastructure\Ballastlane.Tasks.Infrastructure.csproj" />
  </ItemGroup>

</Project>
