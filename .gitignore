# Test results / coverage
TestResults/
[Cc]overage/
*.trx
*.coverage
*.coveragexml

# Local database files
*.mdf
*.ldf
*.ndf

# User secrets / environment files. Covers the actual .NET local-override convention
# (appsettings.Local.json, no extra environment segment) plus case variants, since gitignore
# matching is case-sensitive on Linux (e.g. CI) even though it isn't on Windows.
appsettings.Local.json
appsettings.local.json
appsettings.*.Local.json
appsettings.*.local.json
*.env
.env
.env.*

# Docker local overrides
docker-compose.override.yml

