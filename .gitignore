bin/
obj/
out/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio
.vs/
*.vspscc
*.vssscc

# Rider
.idea/
*.sln.iml

# VS Code (local settings; keep shared launch/tasks configs if intentionally committed)
.vscode/*
!.vscode/extensions.json

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]uild/
[Ll]og/
